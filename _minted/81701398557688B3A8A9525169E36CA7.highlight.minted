                               \PYG{n}{n\PYGZus{}modes}\PYG{o}{=}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{n}{scale}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Animate first mode}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Generating mode shape animation...\PYGZdq{}}\PYG{p}{)}
\PYG{n}{animate\PYGZus{}truss2d\PYGZus{}mode}\PYG{p}{(}\PYG{n}{nodes}\PYG{p}{,} \PYG{n}{members}\PYG{p}{,} \PYG{n}{node\PYGZus{}ids}\PYG{p}{,}
                      \PYG{n}{modes\PYGZus{}2d}\PYG{p}{[:,} \PYG{l+m+mi}{0}\PYG{p}{],} \PYG{n}{free\PYGZus{}dofs\PYGZus{}2d}\PYG{p}{,}
                      \PYG{n}{mode\PYGZus{}num}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{n\PYGZus{}frames}\PYG{o}{=}\PYG{l+m+mi}{60}\PYG{p}{,} \PYG{n}{scale}\PYG{o}{=}\PYG{l+m+mf}{0.5}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Frequency comparison (VQE vs Classical)}
\PYG{n}{plot\PYGZus{}truss2d\PYGZus{}frequency\PYGZus{}comparison}\PYG{p}{(}
